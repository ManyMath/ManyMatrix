# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end

  # Cargokit integration for the manymatrix Rust FFI library.
  #
  # manymatrix (../../flutter_plugin) is a plain Dart FFI package, not a
  # federated plugin, so the consuming app builds the Rust crate itself by
  # attaching cargokit's build phase to the Runner app target. Paths below
  # are relative to this ios/ directory:
  #   repo root        = ../../..
  #   cargokit         = ../../../flutter_plugin/cargokit
  #   rust manifest    = ../../../crates/ffi (libname manymatrix_ffi)
  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    user_project.targets.each do |target|
      next unless target.name == 'Runner'

      phase = target.shell_script_build_phases.find { |p| p.name == 'Build Rust library' } ||
              target.new_shell_script_build_phase('Build Rust library')
      # build_pod.sh resolves the manifest as $PODS_TARGET_SRCROOT/<arg>,
      # which is only defined for pod targets -- point it at this project.
      # Set unconditionally (not just on first creation) so a stale phase
      # from an older Podfile revision always gets refreshed on pod install.
      phase.shell_script = <<-SCRIPT
export PODS_TARGET_SRCROOT="$SRCROOT"
sh "$SRCROOT/../../../flutter_plugin/cargokit/build_pod.sh" ../../../crates/ffi manymatrix_ffi
      SCRIPT
      # build_pod.sh sets CARGOKIT_OUTPUT_DIR=$PODS_CONFIGURATION_BUILD_DIR/
      # $PRODUCT_NAME, so the .a lands in a product-name subdirectory, not
      # directly under $(BUILT_PRODUCTS_DIR).
      phase.output_paths = ['${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}/libmanymatrix_ffi.a']

      # -force_load below makes the Frameworks (link) phase depend on this
      # phase's output -- if link runs first (new_shell_script_build_phase's
      # default append-to-end position), Xcode's new build system reports a
      # dependency cycle. Force this phase to the front so it always builds
      # before Sources/Frameworks/Resources/link, on every pod install.
      target.build_phases.delete(phase)
      target.build_phases.unshift(phase)

      # cargokit only emits the static lib as a build-phase *output* -- nothing
      # actually links it into Runner. -force_load retains every symbol from
      # the archive (a plain -l/-L would drop them, since nothing in Runner's
      # own sources references them directly); the Dart side then opens the
      # running process image instead of a nonexistent .dylib. Set every pod
      # install (idempotent via the include? check), not gated behind the
      # build-phase-exists check above.
      target.build_configurations.each do |config|
        ldflags = config.build_settings['OTHER_LDFLAGS']
        # Xcode stores multi-value settings as an Array once anything sets
        # more than one flag; a bare String only appears on a fresh default.
        ldflags = case ldflags
                  when Array then ldflags.dup
                  when String then [ldflags]
                  else ['$(inherited)']
                  end
        lib_flag = '${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}/libmanymatrix_ffi.a'
        unless ldflags.include?(lib_flag)
          ldflags.push('-force_load', lib_flag)
        end
        config.build_settings['OTHER_LDFLAGS'] = ldflags
      end
    end
    user_project.save
  end
end
